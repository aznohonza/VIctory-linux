+/// A root view of a shader of ours ([`compute_root`]).
+#[derive(Clone, Copy)]
+pub(crate) enum RootView {
+    Srv,
+    Uav,
+    /// A one-view descriptor table at this register (the table itself is
+    /// bound by the caller, as the title's views are).
+    TableSrv,
+    TableUav,
+}
+
+/// The root signature of a compute shader of ours: `constants` root
+/// constants at b0, then `views` (kind and register), in that order. Made
+/// here rather than read from the shader: Wine's HLSL compiler drops
+/// `[RootSignature]` and embeds none.
+pub(crate) fn compute_root(
+    device: &ID3D12Device,
+    constants: u32,
+    views: &[(RootView, u32)],
+) -> windows::core::Result<ID3D12RootSignature> {
+    let mut params: Vec<D3D12_ROOT_PARAMETER1> = Vec::new();
+    // The ranges a table parameter points at, alive through the call.
+    let mut ranges: Vec<Box<D3D12_DESCRIPTOR_RANGE1>> = Vec::new();
+    if constants > 0 {
+        params.push(D3D12_ROOT_PARAMETER1 {
+            ParameterType: D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS,
+            Anonymous: D3D12_ROOT_PARAMETER1_0 {
+                Constants: D3D12_ROOT_CONSTANTS {
+                    ShaderRegister: 0,
+                    RegisterSpace: 0,
+                    Num32BitValues: constants,
+                },
+            },
+            ShaderVisibility: D3D12_SHADER_VISIBILITY_ALL,
+        });
+    }
+    for &(kind, register) in views {
+        let uav = matches!(kind, RootView::Uav | RootView::TableUav);
+        let param = match kind {
+            RootView::Srv | RootView::Uav => D3D12_ROOT_PARAMETER1 {
+                ParameterType: if uav {
+                    D3D12_ROOT_PARAMETER_TYPE_UAV
+                } else {
+                    D3D12_ROOT_PARAMETER_TYPE_SRV
+                },
+                Anonymous: D3D12_ROOT_PARAMETER1_0 {
+                    Descriptor: D3D12_ROOT_DESCRIPTOR1 {
+                        ShaderRegister: register,
+                        RegisterSpace: 0,
+                        Flags: D3D12_ROOT_DESCRIPTOR_FLAG_NONE,
+                    },
+                },
+                ShaderVisibility: D3D12_SHADER_VISIBILITY_ALL,
+            },
+            RootView::TableSrv | RootView::TableUav => {
+                ranges.push(Box::new(D3D12_DESCRIPTOR_RANGE1 {
+                    RangeType: if uav {
+                        D3D12_DESCRIPTOR_RANGE_TYPE_UAV
+                    } else {
+                        D3D12_DESCRIPTOR_RANGE_TYPE_SRV
+                    },
+                    NumDescriptors: 1,
+                    BaseShaderRegister: register,
+                    RegisterSpace: 0,
+                    Flags: D3D12_DESCRIPTOR_RANGE_FLAG_NONE,
+                    OffsetInDescriptorsFromTableStart: 0,
+                }));
+                let range: *const D3D12_DESCRIPTOR_RANGE1 = &**ranges.last().expect("just pushed");
+                D3D12_ROOT_PARAMETER1 {
+                    ParameterType: D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE,
+                    Anonymous: D3D12_ROOT_PARAMETER1_0 {
+                        DescriptorTable: D3D12_ROOT_DESCRIPTOR_TABLE1 {
+                            NumDescriptorRanges: 1,
+                            pDescriptorRanges: range,
+                        },
+                    },
+                    ShaderVisibility: D3D12_SHADER_VISIBILITY_ALL,
+                }
+            }
+        };
+        params.push(param);
+    }
+    let desc = D3D12_VERSIONED_ROOT_SIGNATURE_DESC {
+        Version: D3D_ROOT_SIGNATURE_VERSION_1_1,
+        Anonymous: D3D12_VERSIONED_ROOT_SIGNATURE_DESC_0 {
+            Desc_1_1: D3D12_ROOT_SIGNATURE_DESC1 {
+                NumParameters: params.len() as u32,
+                pParameters: params.as_ptr(),
+                NumStaticSamplers: 0,
+                pStaticSamplers: std::ptr::null(),
+                Flags: D3D12_ROOT_SIGNATURE_FLAG_NONE,
+            },
+        },
+    };
+    // SAFETY: the description points at live arrays; the blob is read in
+    // full before it is released.
+    unsafe {
+        let mut blob: Option<windows::Win32::Graphics::Direct3D::ID3DBlob> = None;
+        D3D12SerializeVersionedRootSignature(&desc, &mut blob, None)?;
+        let blob = blob.ok_or_else(windows::core::Error::empty)?;
+        let bytes =
+            std::slice::from_raw_parts(blob.GetBufferPointer().cast::<u8>(), blob.GetBufferSize());
+        device.CreateRootSignature(0, bytes)
+    }
+}
